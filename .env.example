# Copy to .env — `make` loads it automatically. Values below work for local development.
APP_ENV=development                 # development | test | production
HTTP_ADDR=127.0.0.1:8080
WEB_ORIGIN=http://localhost:5173    # used in email links

# Docker Compose publishes Postgres on this host port (5433 avoids clashing with a local Postgres on 5432)
GATEPASS_DB_PORT=5433
DATABASE_URL=postgres://gatepass_app:gatepass_app@localhost:5433/gatepass?sslmode=disable
# Owner role: used only by migrations (the server runs them at start-up when this is set)
MIGRATE_DATABASE_URL=postgres://gatepass_owner:gatepass_owner@localhost:5433/gatepass?sslmode=disable

STORAGE_DIR=./data/photos
SMTP_HOST=localhost                 # MailHog inbox: http://localhost:8025 (leave empty to only log emails)
SMTP_PORT=1025
SMTP_FROM=gatepass@localhost
BCRYPT_COST=12
SEED_PASSWORD=Gatepass@123          # password of the development seed users
